@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<https://github.com/pilali/pogged>
    a lv2:Plugin, lv2:PitchPlugin ;

    doap:name    "Pogged" ;
    doap:license <https://spdx.org/licenses/GPL-3.0-or-later.html> ;

    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port

    # ── Audio I/O ────────────────────────────────────────────────────────
    [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "audio_in" ;
        lv2:name   "Audio In"
    ] ,
    [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "audio_out" ;
        lv2:name   "Audio Out"
    ] ,

    # ── Voice levels ─────────────────────────────────────────────────────
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   2 ;
        lv2:symbol  "dry_level" ;
        lv2:name    "Dry" ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
        lv2:default 1.0
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   3 ;
        lv2:symbol  "sub1_level" ;
        lv2:name    "Sub Octave" ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
        lv2:default 0.8
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   4 ;
        lv2:symbol  "sub2_level" ;
        lv2:name    "Sub -2 Oct" ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
        lv2:default 0.0
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   5 ;
        lv2:symbol  "up1_level" ;
        lv2:name    "Octave Up" ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
        lv2:default 0.8
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   6 ;
        lv2:symbol  "up2_level" ;
        lv2:name    "2 Octaves Up" ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
        lv2:default 0.0
    ] ,

    # ── Character ────────────────────────────────────────────────────────
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   7 ;
        lv2:symbol  "detune_cents" ;
        lv2:name    "Detune" ;
        lv2:minimum  0.0 ;
        lv2:maximum 25.0 ;
        lv2:default  0.0 ;
        units:unit  units:cent
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   8 ;
        lv2:symbol  "attack_ms" ;
        lv2:name    "Attack" ;
        lv2:minimum    0.0 ;
        lv2:maximum 2000.0 ;
        lv2:default    0.0 ;
        units:unit  units:ms
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   9 ;
        lv2:symbol  "attack_sens" ;
        lv2:name    "Attack Sens" ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:default 0.35
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   10 ;
        lv2:symbol  "lp_cutoff" ;
        lv2:name    "LP Filter" ;
        lv2:minimum    20.0 ;
        lv2:maximum 20000.0 ;
        lv2:default 20000.0 ;
        units:unit  units:hz ;
        lv2:portProperty pprops:logarithmic
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   11 ;
        lv2:symbol  "lp_q" ;
        lv2:name    "Resonance" ;
        lv2:minimum 0.5 ;
        lv2:maximum 8.0 ;
        lv2:default 0.707 ;
        lv2:portProperty pprops:logarithmic
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   12 ;
        lv2:symbol  "out_level" ;
        lv2:name    "Output" ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
        lv2:default 1.0
    ] ,

    # ── Added after 0.2.0 ────────────────────────────────────────────────
    # Appended rather than filed with the other voices: an index is a port's
    # identity, and renumbering would remap state hosts have already saved.
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   13 ;
        lv2:symbol  "up5_level" ;
        lv2:name    "5th Up" ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
        lv2:default 0.0
    ] .
