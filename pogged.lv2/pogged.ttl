@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<https://github.com/pilali/pogged>
    a lv2:Plugin, lv2:PitchPlugin ;

    doap:name    "Pogged" ;
    doap:license <https://spdx.org/licenses/GPL-3.0-or-later.html> ;

    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port

    # ── Audio I/O ────────────────────────────────────────────────────────
    [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "audio_in" ;
        lv2:name   "Audio In"
    ] ,
    [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "audio_out" ;
        lv2:name   "Audio Out L"   # symbol kept: it is the port identity
    ] ,

    # ── Voice levels ─────────────────────────────────────────────────────
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   2 ;
        lv2:symbol  "dry_level" ;
        lv2:name    "Dry" ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
        lv2:default 1.0
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   3 ;
        lv2:symbol  "sub1_level" ;
        lv2:name    "Sub Octave" ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
        lv2:default 0.8
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   4 ;
        lv2:symbol  "sub2_level" ;
        lv2:name    "Sub -2 Oct" ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
        lv2:default 0.0
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   5 ;
        lv2:symbol  "up1_level" ;
        lv2:name    "Octave Up" ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
        lv2:default 0.8
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   6 ;
        lv2:symbol  "up2_level" ;
        lv2:name    "2 Octaves Up" ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
        lv2:default 0.0
    ] ,

    # ── Character ────────────────────────────────────────────────────────
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   7 ;
        lv2:symbol  "detune_cents" ;
        lv2:name    "Detune" ;
        lv2:minimum  0.0 ;
        lv2:maximum 25.0 ;
        lv2:default  0.0 ;
        units:unit  units:cent
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   8 ;
        lv2:symbol  "attack_ms" ;
        lv2:name    "Attack" ;
        lv2:minimum    0.0 ;
        lv2:maximum 2000.0 ;
        lv2:default    0.0 ;
        units:unit  units:ms
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   9 ;
        lv2:symbol  "attack_sens" ;
        lv2:name    "Attack Sens" ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:default 0.35
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   10 ;
        lv2:symbol  "lp_cutoff" ;
        lv2:name    "LP Filter" ;
        lv2:minimum    20.0 ;
        lv2:maximum 20000.0 ;
        lv2:default 20000.0 ;
        units:unit  units:hz ;
        lv2:portProperty pprops:logarithmic
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   11 ;
        lv2:symbol  "lp_q" ;
        lv2:name    "Resonance" ;
        lv2:minimum 0.5 ;
        lv2:maximum 8.0 ;
        lv2:default 0.707 ;
        lv2:portProperty pprops:logarithmic
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   12 ;
        lv2:symbol  "out_level" ;
        lv2:name    "Output" ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
        lv2:default 1.0
    ] ,

    # ── Added after 0.2.0 ────────────────────────────────────────────────
    # Appended rather than filed with the other voices: an index is a port's
    # identity, and renumbering would remap state hosts have already saved.
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   13 ;
        lv2:symbol  "up5_level" ;
        lv2:name    "5th Up" ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
        lv2:default 0.0
    ] ,

    # ── Stereo: mono in → stereo out, POG3-style per-voice pan ───────────
    # The right output sits at 14 rather than beside audio_out for the same
    # reason the pans follow it: appending keeps every existing index stable.
    [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 14 ;
        lv2:symbol "audio_out_r" ;
        lv2:name   "Audio Out R"
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index    15 ;
        lv2:symbol   "pan_dry" ;
        lv2:name     "Pan Dry" ;
        lv2:minimum -1.0 ;
        lv2:maximum  1.0 ;
        lv2:default  0.0
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index    16 ;
        lv2:symbol   "pan_sub1" ;
        lv2:name     "Pan Sub Octave" ;
        lv2:minimum -1.0 ;
        lv2:maximum  1.0 ;
        lv2:default  0.0
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index    17 ;
        lv2:symbol   "pan_sub2" ;
        lv2:name     "Pan Sub -2 Oct" ;
        lv2:minimum -1.0 ;
        lv2:maximum  1.0 ;
        lv2:default  0.0
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index    18 ;
        lv2:symbol   "pan_up5" ;
        lv2:name     "Pan 5th Up" ;
        lv2:minimum -1.0 ;
        lv2:maximum  1.0 ;
        lv2:default  0.0
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index    19 ;
        lv2:symbol   "pan_up1" ;
        lv2:name     "Pan Octave Up" ;
        lv2:minimum -1.0 ;
        lv2:maximum  1.0 ;
        lv2:default  0.0
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index    20 ;
        lv2:symbol   "pan_up2" ;
        lv2:name     "Pan 2 Octaves Up" ;
        lv2:minimum -1.0 ;
        lv2:maximum  1.0 ;
        lv2:default  0.0
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   21 ;
        lv2:symbol  "spread" ;
        lv2:name    "Spread" ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:default 0.0
    ] ,

    # ── Multimode filter + envelope sweep (POG3) ─────────────────────────
    # lp_cutoff / lp_q above keep their "lp_" symbols — a symbol is a port's
    # identity — but now mean the filter frequency and Q in every mode.
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   22 ;
        lv2:symbol  "filter_mode" ;
        lv2:name    "Filter Mode" ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:default 0 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Low Pass" ;  rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Band Pass" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "High Pass" ; rdf:value 2 ]
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index    23 ;
        lv2:symbol   "filter_env" ;
        lv2:name     "Filter Env" ;
        lv2:minimum -1.0 ;
        lv2:maximum  1.0 ;
        lv2:default  0.0
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   24 ;
        lv2:symbol  "filter_env_a" ;
        lv2:name    "Filter Env Attack" ;
        lv2:minimum    1.0 ;
        lv2:maximum 1000.0 ;
        lv2:default   50.0 ;
        units:unit  units:ms ;
        lv2:portProperty pprops:logarithmic
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   25 ;
        lv2:symbol  "filter_env_d" ;
        lv2:name    "Filter Env Decay" ;
        lv2:minimum    1.0 ;
        lv2:maximum 2000.0 ;
        lv2:default  200.0 ;
        units:unit  units:ms ;
        lv2:portProperty pprops:logarithmic
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   26 ;
        lv2:symbol  "filter_sens" ;
        lv2:name    "Filter Env Sens" ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:default 0.5
    ] ,

    # ── Instrument range ─────────────────────────────────────────────────
    # Sizes the sub voices' grains from the lowest note the instrument can
    # play. Trades sub latency for low-end stability; see pogged_dsp.cpp.
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   27 ;
        lv2:symbol  "range_mode" ;
        lv2:name    "Range" ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:default 0 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Guitar" ;   rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Baritone" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Bass" ;     rdf:value 2 ]
    ] ,

    # ── FOCUS: pitch engine (POG3) ───────────────────────────────────────
    # Granular: 3 ms latency, +4.8 dB artifact on a chord (the POG sound).
    # Vocoder:  85 ms latency, +0.0 dB — the ideal-shift floor.
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   28 ;
        lv2:symbol  "focus" ;
        lv2:name    "Focus" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 1 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Granular (fast)" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Vocoder (clean)" ; rdf:value 1 ]
    ] ,

    # ── Input gain + DRY routing (POG3) ──────────────────────────────────
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   29 ;
        lv2:symbol  "input_gain" ;
        lv2:name    "Input Gain" ;
        lv2:minimum 0.5 ;
        lv2:maximum 3.0 ;
        lv2:default 1.0
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   30 ;
        lv2:symbol  "dry_attack" ;
        lv2:name    "Dry: Attack" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty lv2:integer, lv2:toggled
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   31 ;
        lv2:symbol  "dry_filter" ;
        lv2:name    "Dry: Filter" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty lv2:integer, lv2:toggled
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   32 ;
        lv2:symbol  "dry_detune" ;
        lv2:name    "Dry: Detune" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty lv2:integer, lv2:toggled
    ] ,
    # POG3 WARP: whammy-style bend on every voice except the dry. On the pedal
    # this rides an expression pedal; here `warp` IS the pedal position, which
    # a host automates directly. Default 0 (heel, 0 st) = identity, so a saved
    # patch that predates these ports keeps its exact sound.
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   33 ;
        lv2:symbol  "warp" ;
        lv2:name    "Warp" ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:default 0.0
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   34 ;
        lv2:symbol  "warp_heel" ;
        lv2:name    "Warp Heel" ;
        lv2:minimum -12.0 ;
        lv2:maximum 12.0 ;
        lv2:default 0.0 ;
        units:unit units:semitone12TET
    ] ,
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   35 ;
        lv2:symbol  "warp_toe" ;
        lv2:name    "Warp Toe" ;
        lv2:minimum -12.0 ;
        lv2:maximum 12.0 ;
        lv2:default 12.0 ;
        units:unit units:semitone12TET
    ] ,
    # POG3 FREEZE+GLISS. Heel (0) = live; off the heel the octaves hold what
    # you were playing while the dry stays live over them; back to the heel and
    # up again captures the next note and glides to it, the position setting
    # the rate. Deliberately NOT in the modgui: it is a foot control, so it is
    # reached from MOD-UI's settings panel and addressed to an expression pedal
    # or MIDI CC, rather than sitting on the panel as a fader nobody would drag.
    [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index   36 ;
        lv2:symbol  "freeze" ;
        lv2:name    "Freeze + Gliss" ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:default 0.0
    ] .
