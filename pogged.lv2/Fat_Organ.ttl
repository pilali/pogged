@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<Fat_Organ.ttl>
	a pset:Preset ;
	lv2:appliesTo <https://github.com/pilali/pogged> ;
	rdfs:label "Fat Organ" ;
	lv2:port [
		lv2:symbol "attack_ms" ;
		pset:value 0.0
	] , [
		lv2:symbol "attack_sens" ;
		pset:value 0.35
	] , [
		lv2:symbol "detune_cents" ;
		pset:value 6.0
	] , [
		lv2:symbol "dry_attack" ;
		pset:value 0.0
	] , [
		lv2:symbol "dry_detune" ;
		pset:value 0.0
	] , [
		lv2:symbol "dry_filter" ;
		pset:value 0.0
	] , [
		lv2:symbol "dry_level" ;
		pset:value 0.3
	] , [
		lv2:symbol "filter_env" ;
		pset:value 0.0
	] , [
		lv2:symbol "filter_env_a" ;
		pset:value 50.0
	] , [
		lv2:symbol "filter_env_d" ;
		pset:value 200.0
	] , [
		lv2:symbol "filter_mode" ;
		pset:value 0.0
	] , [
		lv2:symbol "filter_sens" ;
		pset:value 0.5
	] , [
		lv2:symbol "focus" ;
		pset:value 0.0
	] , [
		lv2:symbol "input_gain" ;
		pset:value 1.0
	] , [
		lv2:symbol "lp_cutoff" ;
		pset:value 2500.0
	] , [
		lv2:symbol "lp_q" ;
		pset:value 0.707
	] , [
		lv2:symbol "out_level" ;
		pset:value 1.0
	] , [
		lv2:symbol "pan_dry" ;
		pset:value 0.0
	] , [
		lv2:symbol "pan_sub1" ;
		pset:value 0.0
	] , [
		lv2:symbol "pan_sub2" ;
		pset:value 0.0
	] , [
		lv2:symbol "pan_up1" ;
		pset:value 0.0
	] , [
		lv2:symbol "pan_up2" ;
		pset:value 0.0
	] , [
		lv2:symbol "pan_up5" ;
		pset:value 0.0
	] , [
		lv2:symbol "range_mode" ;
		pset:value 0.0
	] , [
		lv2:symbol "spread" ;
		pset:value 0.0
	] , [
		lv2:symbol "sub1_level" ;
		pset:value 1.0
	] , [
		lv2:symbol "sub2_level" ;
		pset:value 0.0
	] , [
		lv2:symbol "up1_level" ;
		pset:value 1.0
	] , [
		lv2:symbol "up2_level" ;
		pset:value 0.7
	] , [
		lv2:symbol "up5_level" ;
		pset:value 0.0
	] .
