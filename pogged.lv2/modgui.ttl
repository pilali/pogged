@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<https://github.com/pilali/pogged>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate    <modgui/icon-pogged.html> ;
        modgui:stylesheet      <modgui/stylesheet-pogged.css> ;
        modgui:javascript      <modgui/script-pogged.js> ;
        modgui:screenshot      <modgui/screenshot-pogged.png> ;
        modgui:thumbnail       <modgui/thumbnail-pogged.png> ;
        modgui:brand           "Pilal" ;
        modgui:label           "Pogged" ;

        # Ports surfaced to the host (parameter list / automation).
        # The icon template binds each fader directly by lv2:symbol.
        modgui:port [
            lv2:index 2 ; lv2:symbol "dry_level"    ; lv2:name "Dry" ;
        ] , [
            lv2:index 3 ; lv2:symbol "sub1_level"   ; lv2:name "Sub Octave" ;
        ] , [
            lv2:index 4 ; lv2:symbol "sub2_level"   ; lv2:name "Sub -2 Oct" ;
        ] , [
            lv2:index 5 ; lv2:symbol "up1_level"    ; lv2:name "Octave Up" ;
        ] , [
            lv2:index 6 ; lv2:symbol "up2_level"    ; lv2:name "2 Octaves Up" ;
        ] , [
            lv2:index 7 ; lv2:symbol "detune_cents" ; lv2:name "Detune" ;
        ] , [
            lv2:index 8 ; lv2:symbol "attack_ms"    ; lv2:name "Attack" ;
        ] , [
            lv2:index 9 ; lv2:symbol "attack_sens"  ; lv2:name "Attack Sens" ;
        ] , [
            lv2:index 10 ; lv2:symbol "lp_cutoff"   ; lv2:name "LP Filter" ;
        ] , [
            lv2:index 11 ; lv2:symbol "lp_q"        ; lv2:name "Resonance" ;
        ] , [
            lv2:index 12 ; lv2:symbol "out_level"   ; lv2:name "Output" ;
        ] ;
    ] .
